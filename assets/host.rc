#include <windows.h>
// Tray / app icon. Replace bubbsy.ico with the real logo before shipping.
101 ICON "bubbsy.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "TheBubbsy"
      VALUE "FileDescription",  "Bubbsy Search host"
      VALUE "ProductName",      "Bubbsy Search"
      VALUE "LegalCopyright",   "Copyright (C) 2026 TheBubbsy. GPL-3.0-or-later."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
